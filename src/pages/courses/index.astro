---
import Base from '../../layouts/Base.astro';

const courses = [
  {
    href: undefined,
    tag: 'SQL',
    title: 'SQL Fundamentals',
    description: 'Learn to query data from scratch. Write real SQL against a live in-browser database — no installs, no accounts.',
    tags: ['Beginners', 'From scratch'],
    price: 'Coming soon',
    cover: 'image',
    image: '/sql-fundemantals-2.png',
    imageAlt: 'SQL Fundamentals course cover',
  },
  {
    href: 'https://olegagapov.gumroad.com/l/cracking-the-analytics-engineering-interview',
    tag: 'Book',
    title: 'Cracking the Analytics Engineering Interview',
    description: 'A practical guide for analytics engineers: resume, portfolio, technical prep, behavioral interviews, and offer strategy.',
    tags: ['Career', 'Guide'],
    price: '$39',
    cover: 'image',
    image: '/cracking-ae-interview-2.png',
    imageAlt: 'Cracking the Analytics Engineering Interview book cover',
  },
];
---

<Base title="Courses — Oleg Agapov">
  <div class="min-h-screen bg-cream font-body">
    <main class="max-w-5xl mx-auto px-6 md:px-14 py-10 md:py-16">

      <h1 class="font-display text-4xl tracking-tight mb-2">Courses</h1>
      <p class="text-base text-gray-500 mb-10">Interactive courses with real SQL running in your browser — no setup required.</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch">
        {courses.map((course) => (
          <a
            href={course.href}
            target={course.href?.startsWith('http') ? '_blank' : undefined}
            rel={course.href?.startsWith('http') ? 'noreferrer' : undefined}
            class:list={[
              'h-full bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden no-underline flex flex-col transition-colors',
              course.href ? 'group hover:border-terra' : 'cursor-default',
            ]}
          >
            <div class="relative aspect-[4/3] overflow-hidden bg-cream-card">
              {course.cover === 'image' ? (
                <img
                  src={course.image}
                  alt={course.imageAlt}
                  class="absolute inset-0 h-full w-full object-cover"
                />
              ) : (
                <div class="absolute inset-0 bg-gray-950 text-gray-100 p-5 flex flex-col justify-between">
                  <div class="flex items-center gap-1.5">
                    <span class="size-2.5 rounded-full bg-terra"></span>
                    <span class="size-2.5 rounded-full bg-amber-300"></span>
                    <span class="size-2.5 rounded-full bg-emerald-400"></span>
                  </div>
                  <div class="font-mono text-[12px] leading-relaxed">
                    <p><span class="text-terra-soft">SELECT</span> customer_id, revenue</p>
                    <p><span class="text-terra-soft">FROM</span> orders</p>
                    <p><span class="text-terra-soft">WHERE</span> status = 'paid'</p>
                    <p><span class="text-terra-soft">ORDER BY</span> revenue DESC;</p>
                  </div>
                  <div class="grid grid-cols-3 gap-2">
                    <span class="h-2 rounded-full bg-white/20"></span>
                    <span class="h-2 rounded-full bg-white/35"></span>
                    <span class="h-2 rounded-full bg-terra"></span>
                  </div>
                </div>
              )}
            </div>

            <div class="p-5 flex flex-1 flex-col">
              <div class="flex items-center justify-between gap-3 mb-4">
                <span class="font-mono text-[11px] bg-cream text-gray-600 px-2.5 py-1 rounded-full">{course.price}</span>
                <span class="font-mono text-[11px] uppercase tracking-widest text-gray-400">{course.tag}</span>
              </div>

              <h2 class="font-display text-2xl font-normal tracking-tight text-gray-900 mb-2 group-hover:text-terra transition-colors duration-150">
                {course.title}
              </h2>

              <p class="text-sm text-gray-500 leading-relaxed mb-5">{course.description}</p>

              <div class="mt-auto flex flex-wrap gap-2">
                {course.tags.map((tag) => (
                  <span class="rounded-full bg-cream px-2.5 py-1 text-xs text-gray-500">{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>

    </main>
  </div>
</Base>
